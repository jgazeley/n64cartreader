# ... (other existing rules) ...

# Build directories (CRITICAL)
build/
firmware/*/build/ # This covers firmware/rp2040/build/ AND any other firmware/XYZ/build/

# Compiled binaries and object files
*.bin
*.elf
*.hex
*.uf2
*.obj
*.exe
*.o
*.a # For static libraries

# Pico SDK specific generated files (ensure these are within your ignored build directories)
*.pio.h # For PIO generated headers (like joybus.pio.h)
generated/ # If there are any general 'generated' folders that are build output but not inside 'build/'

# ... (other rules for Sublime, Python cache, OS files) ...